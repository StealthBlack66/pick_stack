# 두산 강의 예제 환경 설정 템플릿.
#
# 사용법:
#   1. 이 파일을 같은 디렉토리에 .env 로 복사:
#        cp .env.example .env
#   2. .env 안의 주석(#) 풀고 자기 환경 값으로 수정.
#   3. (선택) python-dotenv 설치:
#        pip install python-dotenv
#      미설치여도 export 로 환경변수 직접 지정하면 동일하게 작동.
#
# 우선순위: 셸 export > .env > doosan_config.py 의 default
# 주석(#) 으로 두면 default 값 사용.

# === Robot 식별 ===
# DSR_NAME=dsr01            # ROS namespace. 다른 환경 예: dsr01e0509, doosan_a0912
# DSR_MODEL=e0509           # 로봇 모델: e0509, m1013, h2017, a0912 ...

# === 네트워크 ===
# DSR_HOST=110.120.1.xx     # 로봇 컨트롤러 IP. 미지정 시 DSR_SUBNET 자동 스캔
# DSR_RT_HOST=110.120.1.xx   # PC 측 RT 호스트 IP
# DSR_SUBNET=110.120.1      # 자동 IP 탐색용 서브넷 (마지막 옥텟 .1~.100 스캔)

# === 패키지 / Launch (fork 가 다른 사람용) ===
# DSR_BRINGUP_PKG=dsr_bringup2
# DSR_BRINGUP_LAUNCH=dsr_bringup2_moveit.launch.py
# DSR_MOVEIT_CONTROLLER=dsr_moveit_controller

# === 워크스페이스 / ROS distro ===
# DOOSAN_WS=~/doosan_ws
# ROS_DISTRO=humble

# === LLM (Claude API — 자연어 인터페이스) ===
# 큐브 시뮬레이터의 🤖 LLM 어시스턴트 패널에서 사용. 미설정 시 LLM 패널 비활성.
# 발급: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-api03-...
# (선택) 기본 모델 override:
# CUBE_SIM_LLM_MODEL=claude-haiku-4-5-20251001     # 빠름·저렴 (기본)
# CUBE_SIM_LLM_VISION_MODEL=claude-sonnet-4-6      # Mode C vision 용
